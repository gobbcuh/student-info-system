<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewFlipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">

    <!-- Screen 0: Login Screen -->
    <include
        android:id="@+id/screenLogin"
        layout="@layout/layout_login" />

    <!-- Screen 1: Student Info Academic Record Screen -->
    <include
        android:id="@+id/screenStudentInfo"
        layout="@layout/layout_student_info" />

    <!-- Screen 2: Sign Up Screen -->
    <include
        android:id="@+id/screenSignup"
        layout="@layout/layout_signup" />

    <!-- Screen 3: Forgot Password Screen -->
    <include
        android:id="@+id/screenForgot"
        layout="@layout/layout_forgot" />

</ViewFlipper>