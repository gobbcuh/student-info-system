<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NU Manila SIS"
            android:textColor="#1E4068"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT PORTAL"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Academic Record"
            android:textColor="#172033"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A closer look at your student profile."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01  /  PERSONAL DETAILS"
            android:textColor="#1E4068"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student number"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etStudentNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Enter student number"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:textSize="14sp"
            android:textColor="#172033"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last name"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Enter last name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:textSize="14sp"
            android:textColor="#172033"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First name"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Enter first name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:textSize="14sp"
            android:textColor="#172033"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Middle name"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etMiddleName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Enter middle name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:textSize="14sp"
            android:textColor="#172033"
            android:textColorHint="#94A3B8"
            android:background="@drawable/bg_input" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="02  /  ACADEMIC DETAILS"
            android:textColor="#1E4068"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Program"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="BS Computer Science"
            android:textColor="#172033"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Specialization"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <Spinner
            android:id="@+id/spSpecialization"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:entries="@array/specializations"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Year level"
            android:textColor="#334155"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

        <Spinner
            android:id="@+id/spYearLevel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:entries="@array/year_levels"
            android:background="@drawable/bg_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT INFORMATION SYSTEM"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
